---
// The brand motif: a rising-then-flattening spend curve.
// Usage:
//   <Curve variant="chart" ceilingLabel="your ceiling" subLabel="marginal ROAS crosses 1.0"
//          xLabel="monthly ad spend →" yLabel="← profit" ariaLabel="..." />
//   <Curve variant="divider" />
interface Props {
  variant?: 'chart' | 'divider';
  ceilingLabel?: string;
  subLabel?: string;
  xLabel?: string;
  yLabel?: string;
  ariaLabel?: string;
  animate?: boolean;
  class?: string;
}

const {
  variant = 'chart',
  ceilingLabel = 'your ceiling',
  subLabel,
  xLabel,
  yLabel,
  ariaLabel = 'Illustration: profit rises with ad spend, then flattens at the ceiling',
  animate = true,
  class: className,
} = Astro.props;

const gradientId = `curve-fill-${Math.random().toString(36).slice(2, 8)}`;
---

{
  variant === 'divider' ? (
    <div class:list={['w-full', className]} aria-hidden="true">
      <svg viewBox="0 0 1200 48" preserveAspectRatio="none" class="h-8 w-full">
        <path
          d="M 0 44 C 260 40, 420 14, 640 8 C 830 3, 1020 2, 1200 2"
          fill="none"
          stroke="#2AD17E"
          stroke-opacity="0.25"
          stroke-width="2"
        />
      </svg>
    </div>
  ) : (
    <figure class:list={['select-none', className]}>
      <svg viewBox="0 0 560 360" role="img" aria-label={ariaLabel} class="w-full">
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2AD17E" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#2AD17E" stop-opacity="0" />
          </linearGradient>
          <filter id={`${gradientId}-glow`} x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="7" />
          </filter>
        </defs>

        <line x1="48" y1="20" x2="48" y2="308" stroke="#111318" stroke-opacity="0.3" stroke-width="1" />
        <line x1="48" y1="308" x2="540" y2="308" stroke="#111318" stroke-opacity="0.3" stroke-width="1" />

        {[92, 164, 236].map((y) => (
          <line x1="48" y1={y} x2="540" y2={y} stroke="#111318" stroke-opacity="0.07" stroke-width="1" />
        ))}

        <path
          d="M 48 290 C 150 274, 216 156, 312 108 C 380 74, 462 62, 540 58 L 540 308 L 48 308 Z"
          fill={`url(#${gradientId})`}
        />

        <path
          d="M 48 290 C 150 274, 216 156, 312 108 C 380 74, 462 62, 540 58"
          fill="none"
          stroke="#2AD17E"
          stroke-opacity="0.45"
          stroke-width="6"
          stroke-linecap="round"
          filter={`url(#${gradientId}-glow)`}
        />
        <path
          class:list={[animate && 'curve-path']}
          d="M 48 290 C 150 274, 216 156, 312 108 C 380 74, 462 62, 540 58"
          fill="none"
          stroke="#2AD17E"
          stroke-width="3"
          stroke-linecap="round"
        />

        <line x1="360" y1="88" x2="360" y2="308" stroke="#2AD17E" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="4 5" />
        <circle cx="360" cy="88" r="5.5" fill="#111318" stroke="#127246" stroke-width="3" />

        {ceilingLabel && (
          <text x="352" y="66" text-anchor="end" fill="#111318" font-size="14" font-family="'JetBrains Mono Variable', monospace">
            {ceilingLabel}
          </text>
        )}
        {subLabel && (
          <text x="352" y="84" text-anchor="end" fill="#111318" fill-opacity="0.55" font-size="11" font-family="'JetBrains Mono Variable', monospace">
            {subLabel}
          </text>
        )}
        {xLabel && (
          <text x="540" y="330" text-anchor="end" fill="#111318" fill-opacity="0.45" font-size="11" font-family="'JetBrains Mono Variable', monospace">
            {xLabel}
          </text>
        )}
        {yLabel && (
          <text x="40" y="30" text-anchor="end" fill="#111318" fill-opacity="0.45" font-size="11" font-family="'JetBrains Mono Variable', monospace" transform="rotate(-90 40 30) translate(-8 0)">
            {yLabel}
          </text>
        )}
      </svg>
      <figcaption class="sr-only">
        <slot name="caption" />
      </figcaption>
    </figure>
  )
}

<style>
  @media (prefers-reduced-motion: no-preference) {
    .curve-path {
      stroke-dasharray: 700;
      stroke-dashoffset: 700;
      animation: draw 1.6s ease-out 0.2s forwards;
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
