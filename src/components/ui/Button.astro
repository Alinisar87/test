---
// Usage: <Button href="/audit" variant="primary" size="lg">Get Your Audit</Button>
// Renders <a> when href is given, <button> otherwise.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className } = Astro.props;
const Tag = href ? 'a' : 'button';

const variants = {
  primary:
    'bg-accent-deep font-semibold text-white shadow-[0_0_28px_rgb(42_107_245/0.28)] hover:bg-accent-deep/90 hover:shadow-[0_0_36px_rgb(42_107_245/0.40)] hover:-translate-y-px active:translate-y-0',
  secondary:
    'border border-current/25 font-medium opacity-80 hover:border-accent hover:text-accent hover:opacity-100 hover:-translate-y-px active:translate-y-0',
};
const sizes = {
  md: 'px-4 py-2 text-sm',
  lg: 'px-6 py-3',
};
---

<Tag
  href={href}
  class:list={['inline-block rounded-md transition duration-200', variants[variant], sizes[size], className]}
>
  <slot />
</Tag>
