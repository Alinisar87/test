---
// Usage: <StatTile value="$299" label="flat-fee Profit Curve Audit" />
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="border-l-2 border-accent/40 py-2 pl-5 transition-colors hover:border-accent">
  <p class="data text-4xl text-accent">{value}</p>
  <p class="muted mt-2 text-sm leading-relaxed">{label}</p>
</div>
