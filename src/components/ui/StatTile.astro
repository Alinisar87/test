---
// Usage: <StatTile value="5 days" label="from data access to delivered curve" />
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="border-l-2 border-accent/40 py-2 pl-5 transition-colors hover:border-accent">
  <p class="data text-4xl text-accent-deep">{value}</p>
  <p class="muted mt-2 text-sm leading-relaxed">{label}</p>
</div>
