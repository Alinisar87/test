---
// Usage: <Section variant="offwhite" bordered padding="lg" atmo> ... </Section>
// Dark charcoal by default; "offwhite" flips to light background with charcoal text.
// `atmo` adds the chart-paper grid + accent glow backdrop (hero sections).
interface Props {
  variant?: 'light' | 'dark';
  bordered?: boolean;
  padding?: 'md' | 'lg';
  atmo?: boolean;
  class?: string;
}

const { variant = 'light', bordered = false, padding = 'md', atmo = false, class: className } = Astro.props;
const paddings = {
  md: 'py-12 sm:py-16',
  lg: 'py-16 sm:py-24 lg:py-28',
};
---

<section
  class:list={[
    atmo && 'relative overflow-hidden',
    variant === 'dark' && 'bg-charcoal text-offwhite',
    bordered && 'border-t border-charcoal/10',
    className,
  ]}
>
  {atmo && <div class="hero-atmo" aria-hidden="true" />}
  <div class:list={['mx-auto max-w-6xl px-4 sm:px-6', atmo && 'relative', paddings[padding]]}>
    <slot />
  </div>
</section>
