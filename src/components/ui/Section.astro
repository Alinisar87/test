---
// Usage: <Section variant="offwhite" bordered padding="lg"> ... </Section>
// Dark charcoal by default; "offwhite" flips to light background with charcoal text.
interface Props {
  variant?: 'dark' | 'offwhite';
  bordered?: boolean;
  padding?: 'md' | 'lg';
  class?: string;
}

const { variant = 'dark', bordered = false, padding = 'md', class: className } = Astro.props;
const paddings = {
  md: 'py-12 sm:py-16',
  lg: 'py-16 sm:py-24',
};
---

<section
  class:list={[
    variant === 'offwhite' && 'bg-offwhite text-charcoal',
    bordered && 'border-t border-offwhite/10',
    className,
  ]}
>
  <div class:list={['mx-auto max-w-6xl px-4 sm:px-6', paddings[padding]]}>
    <slot />
  </div>
</section>
