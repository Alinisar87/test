---
// Site header: desktop inline nav; below md a CSS-only slide-down panel (checkbox :checked, zero JS).
import Button from './ui/Button.astro';

const links = [
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/case-studies/shopify-roas-ceiling', label: 'Case Study' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-charcoal/10 bg-offwhite/85 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-label="Open navigation menu" />

    <div class="flex items-center justify-between gap-4 py-4">
      <a
        href="/"
        class="flex items-center gap-2 font-mono text-sm font-semibold tracking-tight text-charcoal"
      >
        <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="none" stroke="#2A6BF5" stroke-opacity="0.35"></rect>
          <path
            d="M4 26 C 10 24, 14 14, 18 10 C 21 7, 25 6, 28 6"
            fill="none"
            stroke="#2A6BF5"
            stroke-width="3"
            stroke-linecap="round"
          ></path>
        </svg>
        Seven Figures <span class="text-accent-deep">Lab</span>
      </a>

      <div class="flex items-center gap-3 md:gap-5">
        <nav aria-label="Main" class="hidden md:block">
          <ul class="flex items-center gap-x-5 text-sm text-charcoal/75">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                    class:list={[
                      'transition-colors hover:text-accent-deep',
                      isActive(link.href) && 'text-accent-deep',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <Button href="/audit" size="md">Get the Audit</Button>
        <label
          for="nav-toggle"
          class="nav-toggle-label flex h-11 w-11 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-md md:hidden"
          aria-hidden="true"
        >
          <span class="nav-bar block h-0.5 w-5 bg-charcoal transition"></span>
          <span class="nav-bar block h-0.5 w-5 bg-charcoal transition"></span>
          <span class="nav-bar block h-0.5 w-5 bg-charcoal transition"></span>
        </label>
      </div>
    </div>

    <nav
      aria-label="Main mobile"
      class="invisible max-h-0 overflow-hidden pb-0 transition-all duration-300 peer-checked:visible peer-checked:max-h-96 peer-checked:pb-4 md:hidden"
    >
      <ul class="flex flex-col border-t border-charcoal/10 pt-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block px-2 py-3 text-base text-charcoal/80 transition-colors hover:text-accent-deep"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Focus ring on the visible label when the (sr-only) checkbox has keyboard focus */
  .peer:focus-visible ~ div .nav-toggle-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* Hamburger → X when open */
  .peer:checked ~ div .nav-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .peer:checked ~ div .nav-bar:nth-child(2) {
    opacity: 0;
  }
  .peer:checked ~ div .nav-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
