---
const links = [
  { href: '/audit', label: 'Audit' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/case-studies/shopify-roas-ceiling', label: 'Case Study' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-offwhite/10">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 sm:px-6"
  >
    <a href="/" class="font-mono text-sm font-semibold tracking-tight text-offwhite">
      Seven Figures <span class="text-accent">Lab</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-offwhite/80">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
