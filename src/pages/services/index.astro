---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

const entry = await getEntry('pages', 'home');
const c = entry?.data as any;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const chips: Record<string, { bg: string; dot: string }> = {
  sky: { bg: 'bg-sky/15', dot: 'bg-sky' },
  violet: { bg: 'bg-violet/15', dot: 'bg-violet' },
  coral: { bg: 'bg-coral/15', dot: 'bg-coral' },
  amber: { bg: 'bg-amber/25', dot: 'bg-amber' },
  accent: { bg: 'bg-accent/15', dot: 'bg-accent' },
};
---

<BaseLayout
  title="Services — full-service performance marketing, one operating rule"
  description="Google Ads, Meta & Paid Social, CRO, SEO, and Email — every channel managed to marginal profit. Packages from $199/month."
>
  <Section padding="lg" atmo>
    <SectionHeader kicker={c.services.kicker} title={c.services.heading} lead={c.services.lead} />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((svc) => {
          const chip = chips[svc.data.color] ?? chips.accent;
          return (
            <a
              href={`/services/${svc.id}/`}
              class="group rounded-xl border border-charcoal/10 bg-white p-6 shadow-[0_2px_16px_rgb(17_19_24/0.05)] transition-all hover:-translate-y-1 hover:shadow-[0_12px_32px_rgb(17_19_24/0.10)]"
            >
              <span class:list={['inline-flex h-10 w-10 items-center justify-center rounded-lg', chip.bg]} aria-hidden="true">
                <span class:list={['h-3.5 w-3.5 rounded-full', chip.dot]} />
              </span>
              <h3 class="mt-4 transition-colors group-hover:text-accent-deep">{svc.data.name}</h3>
              <p class="muted mt-2 text-sm leading-relaxed">{svc.data.description}</p>
            </a>
          );
        })
      }
      <div class="flex flex-col items-start justify-center rounded-xl bg-charcoal p-6 text-offwhite">
        <h3>{c.services.packagesCard.heading}</h3>
        <p class="mt-2 text-sm leading-relaxed text-offwhite/70">{c.services.packagesCard.body}</p>
        <Button href="/pricing" class="mt-5">{c.services.packagesCard.cta}</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
