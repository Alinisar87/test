---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seven Figures Lab — Find your ad-spend ceiling, then move it"
  description="We show you the exact spend level where your next dollar stops making money — then move the ceiling. Profit-first reporting from a chartered-accountant-led team."
>
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-accent">sevenfigureslab.com — scaffold preview</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
      We show you the exact spend level where your next dollar stops making money — then move the
      ceiling.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-offwhite/70">
      Profit-first reporting from a chartered-accountant-led team, not screenshot ROAS. Full site
      is under construction; the Profit Curve Audit page ships first.
    </p>
  </section>
</BaseLayout>
