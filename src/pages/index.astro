---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hl } from '../lib/hl';
import Button from '../components/ui/Button.astro';
import Curve from '../components/ui/Curve.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing content: src/content/pages/home.md');
const c = entry.data as any;

const chips: Record<string, { bg: string; dot: string }> = {
  sky: { bg: 'bg-sky/15', dot: 'bg-sky' },
  violet: { bg: 'bg-violet/15', dot: 'bg-violet' },
  coral: { bg: 'bg-coral/15', dot: 'bg-coral' },
  amber: { bg: 'bg-amber/25', dot: 'bg-amber' },
  accent: { bg: 'bg-accent/15', dot: 'bg-accent' },
};
---

<BaseLayout title={c.title} description={c.description}>
  <section class="relative overflow-hidden">
    <div class="hero-atmo" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:pb-24 lg:pt-28">
      <div>
        <p class="kicker">{c.hero.kicker}</p>
        <h1 class="mt-5 max-w-2xl text-4xl sm:text-5xl lg:text-6xl" set:html={hl(c.hero.heading)} />
        <p class="lead mt-6 max-w-xl">{c.hero.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button href="/audit" size="lg">{c.hero.cta}</Button>
          <p class="muted font-mono text-xs">{c.hero.ctaNote}</p>
        </div>
      </div>
      <Curve
        variant="chart"
        ceilingLabel={c.hero.chart.ceilingLabel}
        subLabel={c.hero.chart.subLabel}
        xLabel={c.hero.chart.xLabel}
        yLabel={c.hero.chart.yLabel}
        ariaLabel={c.hero.chart.ariaLabel}
      >
        <span slot="caption">{c.hero.chart.caption}</span>
      </Curve>
    </div>
  </section>

  <Curve variant="divider" />

  <Section>
    <SectionHeader kicker={c.services.kicker} title={c.services.heading} lead={c.services.lead} />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        c.services.items.map((svc: any) => {
          const chip = chips[svc.color] ?? chips.accent;
          return (
            <a href={svc.href} class="group rounded-xl border border-charcoal/10 bg-white p-6 shadow-[0_2px_16px_rgb(17_19_24/0.05)] transition-all hover:-translate-y-1 hover:shadow-[0_12px_32px_rgb(17_19_24/0.10)]">
              <span class:list={['inline-flex h-10 w-10 items-center justify-center rounded-lg', chip.bg]} aria-hidden="true">
                <span class:list={['h-3.5 w-3.5 rounded-full', chip.dot]} />
              </span>
              <h3 class="mt-4 transition-colors group-hover:text-accent-deep">{svc.name}</h3>
              <p class="muted mt-2 text-sm leading-relaxed">{svc.blurb}</p>
            </a>
          );
        })
      }
      <div class="flex flex-col items-start justify-center rounded-xl bg-charcoal p-6 text-offwhite">
        <h3>{c.services.packagesCard.heading}</h3>
        <p class="mt-2 text-sm leading-relaxed text-offwhite/70">{c.services.packagesCard.body}</p>
        <Button href="/pricing" class="mt-5">{c.services.packagesCard.cta}</Button>
      </div>
    </div>
  </Section>

  <Section bordered>
    <SectionHeader kicker={c.curveSteps.kicker} title={c.curveSteps.heading} lead={c.curveSteps.lead} />
    <ol class="mt-10 grid gap-8 md:grid-cols-3">
      {
        c.curveSteps.items.map((item: any, i: number) => (
          <li>
            <span class="data text-accent-deep" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2">{item.title}</h3>
            <p class="muted mt-2 leading-relaxed">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section bordered>
    <SectionHeader kicker={c.whyUs.kicker} title={c.whyUs.heading} />
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        c.whyUs.items.map((item: any) => (
          <div>
            <h3>{item.title}</h3>
            <p class="muted mt-2 leading-relaxed">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section bordered padding="md">
    <div class="grid gap-10 md:grid-cols-2">
      {
        [c.caseTeaser, c.pricingTeaser].map((teaser: any) => (
          <div class="group flex flex-col items-start rounded-xl border border-charcoal/10 bg-white p-8 shadow-[0_2px_16px_rgb(17_19_24/0.05)] transition-all hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_12px_32px_rgb(17_19_24/0.10)]">
            <p class="kicker">{teaser.kicker}</p>
            <h3 class="mt-3">{teaser.heading}</h3>
            <p class="muted mt-3 leading-relaxed">{teaser.body}</p>
            <Button href={teaser.href} variant="secondary" class="mt-6">
              {teaser.cta}
            </Button>
          </div>
        ))
      }
    </div>
  </Section>

  <Curve variant="divider" />

  <Section padding="lg">
    <div class="max-w-3xl">
      <h2>{c.finalCta.heading}</h2>
      <div class="mt-8">
        <Button href={c.finalCta.href} size="lg">{c.finalCta.cta}</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
