---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Curve from '../components/ui/Curve.astro';
import Section from '../components/ui/Section.astro';
import StatTile from '../components/ui/StatTile.astro';

const facts = [
  { value: '$299', label: 'flat-fee Profit Curve Audit — no retainer required to start' },
  { value: '5 days', label: 'from account access to your curve, delivered on a walkthrough call' },
  { value: 'mROAS', label: 'the one number we optimize: marginal return on the next dollar, not blended ROAS' },
];
---

<BaseLayout
  title="Seven Figures Lab — Find your ad-spend ceiling, then move it"
  description="We show you the exact spend level where your next dollar stops making money — then move the ceiling. Profit-first reporting from a chartered-accountant-led team."
>
  <section class="relative overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:pb-24 lg:pt-28">
      <div>
        <p class="kicker">Performance marketing for ecom founders</p>
        <h1 class="mt-5 max-w-2xl text-4xl sm:text-5xl lg:text-6xl">
          Every ad account has a ceiling. We find yours <span class="text-accent">to the dollar</span> — then move it.
        </h1>
        <p class="lead mt-6 max-w-xl">
          Profit-first reporting from a chartered-accountant-led team, not screenshot ROAS. The
          Profit Curve Audit shows the exact spend level where your next dollar stops making money.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button href="/audit" size="lg">Get the $299 Audit</Button>
          <Button href="/case-studies/shopify-roas-ceiling" variant="secondary" size="lg">
            See it on a real account
          </Button>
        </div>
        <p class="mt-6 font-mono text-xs text-offwhite/60">
          Site under construction — the audit page ships first.
        </p>
      </div>

      <Curve
        variant="chart"
        ceilingLabel="your ceiling"
        subLabel="marginal ROAS crosses 1.0"
        xLabel="monthly ad spend →"
        yLabel="← profit"
        ariaLabel="Illustration: profit rises with ad spend, then flattens at the ceiling — the point where marginal return crosses zero"
      >
        <span slot="caption">
          Profit rises with ad spend, then flattens. The audit finds the exact spend level where
          the next dollar stops making money.
        </span>
      </Curve>
    </div>
  </section>

  <Curve variant="divider" />

  <Section padding="md">
    <div class="grid gap-2 md:grid-cols-3 md:gap-10">
      {facts.map((fact) => <StatTile value={fact.value} label={fact.label} />)}
    </div>
  </Section>
</BaseLayout>
