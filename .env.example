# Copy to .env for local dev; set in Cloudflare Pages → Settings → Environment variables for production.

# Stripe payment link for the $299 Profit Curve Audit (create in Stripe → Payment Links)
PUBLIC_STRIPE_AUDIT_URL=

# Contact form POST endpoint — any provider that accepts a plain form POST:
# Formspree (https://formspree.io/f/xxxx), Web3Forms, or a GHL/webhook endpoint later
PUBLIC_FORM_ENDPOINT=

# Booking embed URL for the thank-you page walkthrough call —
# Cal.com event link (https://cal.com/<user>/<event>), Calendly, or any embeddable scheduler
PUBLIC_BOOKING_URL=

# Google Tag Manager container ID (GTM-XXXXXXX). GTM stays OFF when unset.
PUBLIC_GTM_ID=

# WhatsApp deep link for the contact page (https://wa.me/<number>). Hidden when unset.
PUBLIC_WHATSAPP_URL=
