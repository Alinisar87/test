# Copy to .env and fill in.

# Prisma / database. SQLite for local dev; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (JWT). Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-secret-string-min-32-chars"

# Optional: email of the first admin/staff user created by the seed script.
SEED_ADMIN_EMAIL="admin@efilepak.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
