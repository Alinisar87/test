# Copy to .env and fill in.

# Prisma / database. SQLite for local dev; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (JWT). Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-secret-string-min-32-chars"

# Optional: email of the first admin/staff user created by the seed script.
SEED_ADMIN_EMAIL="admin@efilepak.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Payments (optional) ---
# Gate submission on payment. Default false (flow works without paying).
PAYMENTS_REQUIRED="false"
# mock | safepay | jazzcash  (mock simulates a successful payment)
PAYMENTS_PROVIDER="mock"
# Per-return fee overrides in rupees (defaults: 2000/3000/5000/7500).
# PRICE_SALARIED="2000"
# PRICE_FREELANCER="3000"
# PRICE_BUSINESS="5000"
# PRICE_AOP="7500"

# --- Notifications (optional; without these, messages are logged not sent) ---
# Email via Resend:
# RESEND_API_KEY=""
# EMAIL_FROM="eFile Pak <no-reply@efilepak.pk>"
# WhatsApp via Meta Cloud API:
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
